# OpenAI
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_LLM_MODEL=gpt-5.6-luna
OPENAI_LLM_MODEL_RELEVANCE_CHECK=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL_ENRICHMENT=gpt-4o-mini

# Local llama.cpp OpenAI-compatible server
USE_LOCAL_LLM=true
LOCAL_LLM_BASE_URL=http://localhost:8001/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=qwen3.8-27b
LOCAL_LLM_CONTEXT_WINDOW=32768
LOCAL_LLM_MAX_TOKENS=8192
LOCAL_LLM_TIMEOUT_SECONDS=300

# Gemini (used only when USE_LOCAL_LLM=false)
USE_GEMINI=false
USE_GEMINI_ENRICHMENT=false
GEMINI_API_KEY=
GEMINI_MODEL=


# Local Qdrant; replace URL/key for Qdrant Cloud
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_REGULATORY_COLLECTION=regulatory_updates
QDRANT_POLICIES_COLLECTION=internal_policies
QDRANT_REGULATORY_DENSE_NAME=compliance
QDRANT_POLICIES_DENSE_NAME=internal_policy
QDRANT_SPARSE_NAME=legal_clause


# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Arize Phoenix (local)
PHOENIX_ENDPOINT=http://localhost:6006
PHOENIX_EXTERNAL=true

# LangWatch
LANGWATCH_API_KEY=

# Reranker
VOYAGE_API_KEY=

# Acquisition validation
CONTENT_VALIDATION_MIN_CHARS=500
CONTENT_VALIDATION_LLM_ENABLED=true
CONTENT_VALIDATION_LLM_MODEL=gpt-4o-mini
CONTENT_VALIDATION_CONFIDENCE_THRESHOLD=0.8
QUARANTINE_FILE=data/quarantine/rejected_documents.jsonl
# Local: postgresql://legal_agent:local_dev_only@localhost:5433/legal_agent
# Managed Postgres: use its direct connection string and require TLS, e.g. sslmode=verify-full
DATABASE_URL=postgresql://legal_agent:local_dev_only@localhost:5433/legal_agent
WORKFLOW_LEASE_SECONDS=1800

# Obligation-centric retrieval
OBLIGATION_EXTRACTION_MAX=30
OBLIGATION_RETRIEVAL_TOP_K=20
OBLIGATION_RETRIEVAL_FINAL_K=5
OBLIGATION_MIN_EVIDENCE_HITS=1
OBLIGATION_MIN_RETRIEVAL_SCORE=0.0
OBLIGATION_NEIGHBOR_HOPS=1
